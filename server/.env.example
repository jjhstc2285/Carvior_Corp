# MySQL 8
DATABASE_URL="mysql://anyone:비밀번호@localhost:3306/anyone_motors"

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT — 반드시 새로 만들어 쓸 것: openssl rand -base64 48
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# 시드용 관리자 초기 비밀번호(시드 1회 실행 후 바꾸는 걸 권장)
ADMIN_DEFAULT_PASSWORD=change-me

# API 서버 포트 — Apache가 이 포트로 프록시한다
PORT=3000

# CORS 허용 오리진(쉼표 구분). 개발 중 Vite dev 서버를 함께 넣어둔다.
CORS_ORIGINS=https://skv1motors.com,https://www.skv1motors.com,http://localhost:5173

# 업로드 파일 저장 경로
UPLOAD_DIR=./uploads

# 웹 푸시(VAPID) — 브라우저를 닫아둔 사람에게 알림을 보내는 데 쓴다.
# 키 생성: npx web-push generate-vapid-keys
# 비워두면 푸시 기능만 꺼진 채로 서버가 뜬다(프론트도 '알림 켜기' 버튼을 감춘다).
# 키를 바꾸면 기존 구독이 전부 무효가 되므로 한 번 정하면 그대로 둘 것.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@skv1motors.com

# 카비어(carvior.store) 파트너 API — 수출 상담에서 성사된 계약을 읽어온다.
# 열쇠는 저장소에 넣지 않는다. 비워두면 연동 기능만 꺼진 채로 서버가 뜬다.
CARVIOR_BASE_URL=https://carvior.store
CARVIOR_PARTNER=anyone-motors
CARVIOR_CLIENT_ID=
CARVIOR_CLIENT_SECRET=
# 성사된 계약을 매입 관리에 자동으로 넣는 주기(분). 0이면 끈다. 안 적으면 10분.
CARVIOR_AUTO_IMPORT_MINUTES=10
# 자동 등록 건을 누구 이름으로 남길지. 비우면 가장 먼저 만든 관리자.
CARVIOR_IMPORT_EMPLOYEE_ID=

# 상조회비 이체일 알림을 보낼 시각(한국 시각, 0~23). 음수면 끈다. 안 적으면 9시.
DEALER_FEE_REMINDER_HOUR=9

# 광고 약정 소진을 확인해 알릴 시각(한국 시각, 0~23). 음수면 끈다. 안 적으면 10시.
AD_REMINDER_HOUR=10

# 부동산 탭에 들어갈 때 한 번 더 받는 번호(대외비 화면). 안 넣으면 아무도 못 연다.
PROPERTY_ACCESS_CODE=0000

# 주차위치 현황판(따로 돌아가는 앱)을 읽어올 곳. 읽기만 한다 — 아무것도 쓰지 않는다.
# 방 코드가 바뀌면 여기만 고치면 된다.
PARKBOARD_URL=https://kp-system-8e4eb-default-rtdb.firebaseio.com
PARKBOARD_CODE=hangyul2024

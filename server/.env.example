# MySQL 8
DATABASE_URL="mysql://anyone:비밀번호@localhost:3306/anyone_motors"

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT — 반드시 새로 만들어 쓸 것: openssl rand -base64 48
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# 시드용 관리자 초기 비밀번호(시드 1회 실행 후 바꾸는 걸 권장)
ADMIN_DEFAULT_PASSWORD=change-me

# API 서버 포트 — Apache가 이 포트로 프록시한다
PORT=3000

# CORS 허용 오리진(쉼표 구분). 개발 중 Vite dev 서버를 함께 넣어둔다.
CORS_ORIGINS=https://skv1motors.com,https://www.skv1motors.com,http://localhost:5173

# 업로드 파일 저장 경로
UPLOAD_DIR=./uploads

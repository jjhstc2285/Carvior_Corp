// 애니원모터스 통합 관리 시스템 스키마 (MySQL 8)
//
// 금액 컬럼 단위는 프론트와 맞춰 전부 "만원"이고 정수로 저장한다.
// 날짜는 @db.Date(시각 없음), 출퇴근 시각은 "HH:mm" 문자열로 둔다(기존 화면 로직과 동일).
// 긴 자유입력(내용·사유·메모)은 VARCHAR(191) 기본값으로는 모자라서 @db.Text 를 붙였다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// 임직원 / 권한
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  EMPLOYEE
}

enum AuthProvider {
  KAKAO
  NAVER
  LOCAL
}

model Employee {
  id         String  @id @default(cuid())
  name       String
  position   String // 직책 — 대표 / 본부장 / 사무장 / 차장 / 과장 / 매니저
  department String?
  role       Role    @default(EMPLOYEE)
  active     Boolean @default(true)

  // 로그인 수단 — 소셜은 provider+providerId, 관리자 계정은 loginId+passwordHash
  provider     AuthProvider?
  providerId   String?
  loginId      String?       @unique
  passwordHash String?

  /**
   * 지금 상태 — "🚗 외근 중", "🍜 점심", "📞 통화 중" 처럼 본인이 적는다.
   * 근태 신청(연차·외근)과는 다르다. 그건 승인을 받는 기록이고 이건 지금 옆자리에
   * 대고 말하는 것에 가깝다. 그래서 승인도 이력도 없이 지금 값만 들고 있는다.
   * 언제 적었는지를 같이 둔다 — 어제 적어둔 '외근 중'이 오늘까지 붙어 있으면
   * 안 보느니만 못하다. 오래된 건 화면에서 흐리게 처리한다.
   */
  statusEmoji String?   @db.VarChar(8)
  statusText  String?   @db.VarChar(40)
  statusAt    DateTime?

  /**
   * 알선팀 타이틀 — LEADER(팀장) / PRO(프로 딜러) / JUNIOR(주니어).
   *
   * 직책(position)과 다르다. 직책은 회사 안에서의 자리고, 이건 알선팀 안에서의 등급이라
   * 실적으로 오르내린다. 이름 옆에 붙어 누가 팀장인지 한눈에 보이게 하고, 인센티브
   * 정산에서 팀장 오버라이딩을 누구에게 줄지도 이 값으로 가른다.
   *
   * 비어 있으면 알선팀이 아니다.
   */
  referralTitle String @default("") @db.VarChar(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 본부장님·강예원 매니저님처럼 번호가 2개인 분이 있어 별도 테이블로 뺐다.
  // (MySQL은 PostgreSQL과 달리 배열 컬럼을 못 쓴다)
  phones EmployeePhone[]

  attendanceRecords    AttendanceRecord[]
  correctionRequests   CorrectionRequest[]
  attendanceRequests   AttendanceRequest[]
  notifications        Notification[]
  consultations        Consultation[]
  settlements          Settlement[]
  brokerageSettlements BrokerageSettlement[]
  dealerIncentives     DealerIncentive[]
  purchaseSettlements  PurchaseSettlement[]
  parkingVehicles      ParkingVehicle[]
  vehiclePosts         VehiclePost[]
  workLogs             WorkLog[]
  vehicleExpenses      VehicleExpenseLog[]
  conversations        Conversation[]        @relation("ConversationEmployee")
  adminConversations   Conversation[]        @relation("ConversationAdmin")
  chatMessages         ChatMessage[]
  pushSubscriptions    PushSubscription[]
  purchaseIntakes      PurchaseIntake[]
  cleaningLogs         CleaningLog[]
  approvalDocuments    ApprovalDocument[]    @relation("ApprovalWriter")
  approvalReviews      ApprovalDocument[]    @relation("ApprovalReviewer")

  @@unique([provider, providerId])
  @@index([name])
  dismissedCalls DismissedCall[]
  washVisits WashVisit[]
  photoSets VehiclePhotoSet[]
  condolences Condolence[]
  notices     Notice[]
}

model EmployeePhone {
  id         String @id @default(cuid())
  employeeId String
  number     String
  sortOrder  Int    @default(0)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, sortOrder])
  @@index([number])
}

// ─────────────────────────────────────────────
// ① 출퇴근
// ─────────────────────────────────────────────

model AttendanceRecord {
  id         String   @id @default(cuid())
  employeeId String
  date       DateTime @db.Date
  clockIn    String? // "HH:mm"
  clockOut   String? // "HH:mm"

  /**
   * 그날 구내식당(함바집)에서 먹었는가.
   *
   * 식대는 출퇴근으로 자동으로 센다(9시 30분까지 찍고 6시 넘겨 찍은 날). 그런데 외근을
   * 나가거나 손님과 밖에서 먹는 날이 있어, 찍었다고 다 먹은 것은 아니다.
   *
   * 비어 있으면(null) 출퇴근으로 자동 판정한다 — 평소에는 아무도 손대지 않아도 된다.
   * 사람이 켜거나 끄면 그 값이 자동 판정을 이긴다.
   */
  mealUsed Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([date])
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// 근태 수정(정정) 요청
model CorrectionRequest {
  id                String        @id @default(cuid())
  employeeId        String
  date              DateTime      @db.Date
  reason            String        @db.Text
  requestedClockIn  String?
  requestedClockOut String?
  status            RequestStatus @default(PENDING)
  reviewedAt        DateTime?
  reviewNote        String?       @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
}

enum AttendanceRequestKind {
  ANNUAL_LEAVE // 연차
  HALF_DAY // 반차 — 반나절만 쉰다. 연차를 0.5일 쓴 것으로 센다
  FIELD_WORK // 외근/출장
  AWAY // 자리비움 — 근무 중 잠깐 자리를 뜬다. 하루에 여러 번 있을 수 있다
  LATE_EXCUSE // 지각·조퇴 소명 — 승인되면 그날을 정상 출근으로 본다
}

model AttendanceRequest {
  id         String                @id @default(cuid())
  employeeId String
  date       DateTime              @db.Date
  kind       AttendanceRequestKind
  reason     String                @db.Text
  /**
   * 증빙 사진 — 반차·조퇴에 병원 영수증·진단서 같은 것을 붙인다.
   *
   * 글로만 적으면 승인하는 쪽에서 되물어야 하고, 그러느라 하루가 간다.
   * 여러 장이면 줄바꿈으로 이어 담는다(정산 계약서 사진과 같은 꼴).
   *
   * 남이 볼 값이 아니다 — 신청 목록은 전 직원이 보지만 사진은 본인과 관리자에게만 내준다.
   */
  photos     String                @default("") @db.Text
  status     RequestStatus         @default(PENDING)
  reviewedAt DateTime?
  reviewNote String?               @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@index([date])
}

/**
 * 상조회비를 어떻게 받는가
 */
enum DealerFeeMethod {
  AUTO // 자동이체
  DIRECT // 직접이체
  CANCELED // 자동이체 해지
}

/**
 * 신차영업소 상조회비 납부현황.
 * 엑셀로 돌리던 대장을 그대로 옮겼다. 이체날짜·회비·기한이 수시로 바뀌고
 * 하는 곳도 있어서, 바뀌면 사무장과 대표에게 알린다.
 * 날짜 꼴이 제각각이라(매달5일 / 10-01 / 매달1일고정 / 직접이체) 날짜형으로 두지 않고
 * 적힌 그대로 문자열로 받는다. 억지로 맞추면 원장과 달라진다.
 */
model DealerFeeAccount {
  id           String    @id @default(cuid())
  dealerName   String    @db.VarChar(60) // 업체명
  managerName  String    @default("") @db.VarChar(30) // 담당자
  managerPhone String    @default("") @db.VarChar(20) // 담당연락처
  startedOn    DateTime? @db.Date // 거래시작일

  bank          String @default("") @db.VarChar(30) // 은행
  accountHolder String @default("") @db.VarChar(30) // 예금주
  accountNumber String @default("") @db.VarChar(40) // 자동이체계좌

  transferDay        String @default("") @db.VarChar(30) // 자동이체날짜 — 적힌 그대로
  // 위 문장에서 뽑아낸 이체일(1~31). 0이면 정해진 날이 없다(직접이체 등).
  // 원문은 그대로 두고 숫자만 따로 둔다 — 알림은 숫자로 돌고, 원장은 적힌 대로 남는다.
  transferDayOfMonth Int    @default(0)
  monthlyFee         Int    @default(0) // 매달 회비(원)
  // 금액으로 안 떨어지는 조건은 적힌 그대로 남긴다 — 사람이 보고 판단할 일이다.
  feeNote            String @default("") @db.VarChar(60)

  method DealerFeeMethod @default(AUTO) // 자동이체여부

  autoTransferUntil String @default("") @db.VarChar(30) // 자동이체기한 — "2026년12월"
  note              String @default("") @db.VarChar(255) // 비고
  memo              String @default("") @db.VarChar(255) // 오른쪽 여백에 적던 말

  // 사진 한 장 — 명함·간판·약정서처럼 글로 못 적는 것.
  // 한 장만 받는다. 여러 장을 받으면 어느 게 지금 맞는 것인지 아무도 모른다.
  photo String @default("") @db.VarChar(300)

  active Boolean @default(true) // 거래 종료하면 내린다

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealerName])
  @@index([active])
}

/**
 * 결재 문서 종류.
 * 지금은 시말서 하나지만 휴가원·지출결의서처럼 늘어난다. 양식마다 표를 따로 만들지 않고
 * 종류로 가른다 — 결재 흐름(작성 → 대기 → 승인/반려)은 어느 양식이나 같다.
 */
enum ApprovalKind {
  INCIDENT_REPORT // 시말서
  LEAVE // 휴가원
  EXPENSE // 지출결의서
}

/**
 * 결재 문서.
 * 부서·직위·성명은 작성 시점의 값을 문서에 박아 남긴다. 직원 정보를 참조만 하면
 * 나중에 부서가 바뀌었을 때 옛 문서의 소속까지 따라 바뀐다 — 그건 다른 문서가 된다.
 */
model ApprovalDocument {
  id         String       @id @default(cuid())
  kind       ApprovalKind @default(INCIDENT_REPORT)
  employeeId String // 작성자

  department String   @default("") @db.VarChar(30) // 작성 시점의 부서
  position   String   @default("") @db.VarChar(30) // 작성 시점의 직위
  name       String   @db.VarChar(30) // 작성 시점의 성명
  content    String   @db.Text // 내용 — 시말서는 경위, 휴가원은 사유, 지출결의서는 적요
  writtenOn  DateTime @db.Date // 작성일자

  /*
    ── 시말서 ──

    회사 종이 양식을 그대로 옮긴 칸들이다. 양식에는 네 꼭지(사건 및 경위 / 발생 원인 및
    사유 / 조치 사항 / 재발 방지 대책)와 발생 일시·장소가 있는데, 한 칸(content)에
    몰아 적게 해 두었더니 적는 사람마다 꼭지를 빼먹거나 순서가 달라져서, 뽑아 놓으면
    종이 양식과 다른 문서가 됐다.

    사건 및 경위는 content 를 그대로 쓴다 — 이미 적힌 시말서를 옮겨 적게 하지 않는다.

    발생 시각은 글자로 둔다. "오후 3시쯤"처럼 적어 오는 일이 많아서 시:분으로 받으면
    없는 정확함을 만들게 된다.
  */
  occurredOn    DateTime? @db.Date
  occurredTime  String    @default("") @db.VarChar(30)
  occurredPlace String    @default("") @db.VarChar(60)
  cause         String    @default("") @db.Text
  action        String    @default("") @db.Text
  prevention    String    @default("") @db.Text

  // ── 휴가원 ──
  // 양식마다 칸이 달라 비어 있을 수 있다. JSON 한 칸에 몰아넣지 않는 이유는
  // 나중에 "이번 달 휴가 며칠", "이번 달 지출 얼마"를 물어보려면 칸이어야 해서다.
  leaveKind String    @default("") @db.VarChar(20) // 연차 / 반차 / 병가 / 경조 / 기타
  startOn   DateTime? @db.Date
  endOn     DateTime? @db.Date
  days      Float? // 0.5 단위

  // ── 지출결의서 ──
  spentOn DateTime? @db.Date // 지출일
  amount  Int       @default(0) // 금액(원)
  payee   String    @default("") @db.VarChar(60) // 지출처

  status     RequestStatus @default(PENDING)
  reviewerId String? // 결재한 사람
  reviewedAt DateTime?
  reviewNote String?       @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee  @relation("ApprovalWriter", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer Employee? @relation("ApprovalReviewer", fields: [reviewerId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([writtenOn])
}

/**
 * 광고 계약.
 * 광고 상품은 '월 몇 대'로 팔린다 — 22만원짜리가 월 30대, 3개월이면 90대다.
 * 3달에 30대만 올리면 60대분은 그냥 날아간다. 얼마나 썼는지 보이게 하려고 만들었다.
 * 금액은 원 단위다. 광고비는 22만원처럼 만원으로 떨어지지 않는 경우가 있다.
 */
model AdContract {
  id          String @id @default(cuid())
  platform    String @db.VarChar(30) // 엔카 / KB차차차 …
  productName String @default("") @db.VarChar(60) // "22만원 상품"

  /**
   * 대당 얼마짜리 상품인가. 22만원 상품이면 한 대 올릴 때마다 22만원이다 —
   * 달마다 정액으로 나가는 게 아니라 찍은 대수만큼 나간다.
   */
  unitFee Int @default(0)

  /**
   * 약정. 22만원 상품은 분기마다 90대를 찍어야 하고, 10만원 상품은 대수 제약이 없다.
   * 제약이 없으면 quotaCycle 을 '없음'으로 두고 돈만 센다.
   */
  quotaCycle String @default("분기") @db.VarChar(4) // 분기 / 월 / 없음
  quotaCount Int    @default(0) // 그 주기에 찍어야 하는 대수 — 분기 90

  months Int @default(12) // 계약 개월 수

  startOn DateTime @db.Date
  endOn   DateTime @db.Date // 시작일 + 개월 수. 계약마다 마감이 달라 따로 둔다
  note    String   @default("") @db.VarChar(255)
  active  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postings AdPosting[]

  @@index([active, endOn])
  @@index([platform])
}

/**
 * 그 계약으로 올린 차 한 대.
 * 매물 사진 등록에 올라온 건 자동으로 세고(같은 플랫폼·기간), 거기 없는 건 손으로 넣는다.
 * 같은 차를 두 번 세지 않게 계약 안에서 차량번호는 하나뿐이다.
 */
model AdPosting {
  id            String   @id @default(cuid())
  contractId    String
  vehicleNumber String   @db.VarChar(30)
  postedOn      DateTime @db.Date
  /**
   * 매물 사진 등록에서 자동으로 잡힌 건지
   */
  auto          Boolean  @default(false)
  memo          String   @default("") @db.VarChar(255)

  createdAt DateTime @default(now())

  contract AdContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, vehicleNumber])
  @@index([contractId, postedOn])
}

/**
 * 월별 광고비 — 엔카·차차차 약정 말고, 구글 애즈·114·채널웍스·알바천국처럼
 * 달마다 얼마를 썼는지만 남기는 광고.
 * 끊은 채널도 0원·종료로 남긴다 — 안 적으면 끊은 건지 잊은 건지 알 수 없다.
 */
model AdSpend {
  id      String @id @default(cuid())
  month   String @db.VarChar(7) // YYYY-MM
  channel String @db.VarChar(30) // 구글 애즈 / 114 우선문의 / 알바천국 …
  amount  Int    @default(0) // 원
  status  String @default("") @db.VarChar(10) // 신규 / 유지 / 중지 / 종료
  owner   String @default("") @db.VarChar(30) // 담당 — 이태희 / 안원용
  memo    String @default("") @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([month])
}

/**
 * 광고 운영 현황 메모.
 *
 * 대행사 주차별 보고처럼 여러 줄짜리 글. 광고비 표의 한 줄 메모에는 안 들어간다.
 */
model AdReport {
  id      String @id @default(cuid())
  month   String @db.VarChar(7) // YYYY-MM
  channel String @db.VarChar(30) // 구글 애즈 / 114 우선문의 …
  title   String @default("") @db.VarChar(60) // 9월 1주차 …
  body    String @db.Text // 붙여 넣은 그대로 — 줄바꿈을 살린다
  author  String @default("") @db.VarChar(30) // 올린 사람 — 서버가 박는다

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([month, channel])
}

enum NotificationType {
  MISSING
  CORRECTION_REQUEST
  ATTENDANCE_REQUEST
  MILEAGE_GAP // 실차 확인 주행거리가 처음 적은 것과 많이 벌어졌다
  DEALER_FEE // 신차영업소 상조회비 조건이 바뀌었다
  APPROVAL // 결재 문서가 올라오거나 처리됐다
  AD_QUOTA // 광고 약정 대수가 남았는데 기간이 얼마 안 남았다
  RELEASE_PENDING // 상담이 판매완료로 찍혔다 — 광고 내리고 출고 준비를 해야 한다
  REINSPECTION // 이전한 지 넉 달이 지났다 — 재검을 다시 받아야 한다
}

/**
 * 구전을 어떻게 주는가. 세금 처리가 달라서 금액만으로는 실지급액을 알 수 없다.
 * 현금이 제일 많다.
 */
/**
 * 손님이 차값을 어떻게 치렀는가.
 * 재고금융을 쓴 캐피탈에는 그 회사 할부를 얼마 이상 깔아 줘야 하는 약정이 있다.
 * 무엇을 깔았는지 적어두지 않으면 약정을 채웠는지 셀 방법이 없다.
 */
enum PayMethod {
  UNKNOWN // 아직 안 정했거나 안 적은 건
  CASH // 현금 — 일시불·계좌이체 포함
  INSTALLMENT // 할부
}

enum BrokerFeeType {
  CASH // 현금 — 원천징수 없음
  WITHHOLD_3_3 // 3.3% 원천징수
  WITHHOLD_13_3 // 13.3% 원천징수
}

model Notification {
  id         String           @id @default(cuid())
  type       NotificationType
  message    String           @db.Text
  employeeId String
  date       DateTime         @db.Date
  read       Boolean          @default(false)

  createdAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([read])
}

// 출근 등록을 허용할 사무실 IP
model IpWhitelist {
  ip        String   @id
  label     String?
  createdAt DateTime @default(now())
}

// 출근 등록을 허용할 단말(그 자리 PC).
//
// 사무실 WiFi에 붙은 휴대폰과 자리 PC는 같은 공인 IP로 나가기 때문에 IP만으로는 못 가른다.
// 그래서 등록한 PC 브라우저에만 키를 심어두고, 그 키를 들고 온 요청만 출근을 찍게 한다.
// 키 원본은 발급 때 한 번만 내려주고 서버에는 해시만 남긴다(유출돼도 DB에서 원본이 안 나오게).
model AttendanceDevice {
  id        String @id @default(cuid())
  tokenHash String @unique // 발급한 키의 SHA-256
  label     String // 어느 자리 PC인지 알아볼 이름

  // 브라우저 저장소에 심은 키는 '인터넷 사용기록 삭제'에 같이 날아간다(쿠키·세션도 마찬가지).
  // 그때 다시 등록하러 오지 않아도 되게, 그 PC를 알아볼 지문을 서버에 남겨둔다.
  // 화면 크기·시간대·CPU 코어 수 같은 값을 모아 해시한 것이라 기록을 지워도 그대로다.
  //
  // 지문만으로 통과시키지는 않는다 — 사무실 IP 안에서만 키를 다시 내준다.
  // 지문은 흉내낼 수 있지만 사무실 네트워크는 그렇지 않다.
  fingerprint String? @unique

  active     Boolean   @default(true)
  lastUsedAt DateTime? // 마지막으로 이 단말에서 출근이 찍힌 시각
  createdAt  DateTime  @default(now())
}

// ─────────────────────────────────────────────
// ② 알선 상담
// ─────────────────────────────────────────────

// 상담 → 계약 → 판매완료 → (정산) 순으로 간다.
// 보류·종결은 그 흐름에서 빠지는 갈래다.
/**
 * 상담 종류. 알선과 수출은 받는 창구도 손님도 다르지만, 적는 내용과 흐름
 * (상담 → 계약 → 종결 → 판매완료)이 같아서 한 표에 두고 구분만 나눈다.
 */
/**
 * 상담 넷.
 *
 * 누구 물건을 누가 파느냐로 갈린다 — 돈이 어디로 가는지가 거기서 정해진다.
 *  - SALE      우리 담당자가 우리 상사 물건을 판다
 *  - BROKERAGE 우리 담당자가 남의 상사 물건을 판다 (알선)
 *  - EXPORT    수출
 *  - OTHER     남의 딜러가 우리 상사 물건을 판다 — 담당자가 우리 직원이 아니다
 */
enum ConsultationKind {
  SALE // 판매 — 우리 상사 차를 우리가 판다
  PARTNER // 타사 — 다른 상사 차를 손님에게 붙인다. 유입 경로도 딜러 플랫폼이라 따로 센다
  BROKERAGE // 알선
  EXPORT // 수출
  OTHER // 기타 — 전화문의·방문처럼 차를 안 짚고 들어오는 건
}

enum ConsultationStatus {
  IN_PROGRESS
  CONTRACTED
  SOLD // 판매완료 — 출고까지 끝난 건. 여기서부터 정산 대상이 된다
  ON_HOLD
  CLOSED

  /**
   * 방문취소 — 약속은 잡혔는데 손님 쪽에서 안 오기로 한 것.
   *
   * 맡은 딜러는 그 시간을 비워 두고 기다렸을 뿐 손님을 맞은 게 아니다. 그런데도 '한 건
   * 맡았다'로 세면, 다음 손님이 올 때 그 딜러는 이미 몫을 채운 사람이 되어 뒤로 밀린다.
   * 이 상태인 건은 방문 배정에서 안 세고, 그 시간도 다시 빈 자리가 된다.
   *
   * 종결과는 다르다 — 종결은 상담이 끝난 것이고, 이건 그날 안 온 것뿐이다.
   */
  VISIT_CANCELED
}

// 알선 상담. 카톡으로 주고받던 양식을 그대로 옮겼다 —
// 플랫폼 / 차량번호 / 차명 / 손님번호 / 내용.
//
// 고객명(customerName)은 예전 양식의 흔적이다. 새 양식은 이름 대신 손님번호로 부르지만,
// 이미 이름으로 적어둔 상담이 있어서 지우지 않고 남긴다(화면에서는 번호가 없을 때만 보인다).
model Consultation {
  id            String             @id @default(cuid())
  // 구글 시트에서 옮겨온 건의 원래 번호. 두 번 넣어도 겹치지 않게 이걸로 가른다.
  // 앱에서 새로 적은 건은 비어 있다.
  sourceId      String?            @db.VarChar(30)
  kind          ConsultationKind   @default(BROKERAGE) // 판매 / 알선 / 수출 / 기타

  /**
   * 기타 상담에서 판 사람 — 남의 딜러나 그 상사 이름.
   *
   * 우리 직원이 아니라 employeeId 로 못 적는다. 이름만 받아 둔다 — 그 사람이 또 올지도
   * 모르고, 오더라도 우리 계정을 만들 일은 없다.
   */
  outsideDealer String @default("") @db.VarChar(60)
  platform      String             @default("") @db.VarChar(30) // 엔카·KB차차차 등 유입 경로
  vehicleNumber String
  vehicleName   String             @default("") @db.VarChar(60) // 차명
  customerPhone String             @default("") @db.VarChar(20) // 손님번호
  customerName  String             @default("")
  employeeId    String
  status        ConsultationStatus @default(IN_PROGRESS)
  date          DateTime           @db.Date
  time          String // "HH:mm"
  content       String             @db.Text

  // 손님이 언제 오기로 했는가. 카톡 양식에 "오후 3시~4시 방문"처럼 적혀 오는데,
  // 시간이 범위이거나 두루뭉술한 경우가 많아 시각은 적힌 그대로 문자열로 둔다.
  // 날짜만 따로 두면 달력에 방문 예정을 띄울 수 있다.
  visitDate DateTime? @db.Date
  visitTime String    @default("") @db.VarChar(30)

  /**
   * 그날 손님을 맞을 담당 딜러.
   *
   * employeeId 는 전화를 받아 적은 사람이다. 손님이 오는 날 붙어 있을 사람은 그와 다를
   * 수 있어 따로 둔다 — 전화받은 사람이 알선팀에서 골라 지정하고, 비워 두면 자동으로
   * 나눈다(한 시간 자리에 한 사람, 적게 맡은 사람부터).
   */
  visitDealerId String?


  /**
   * 왜 계약이 안 됐는가 — 손님이 다녀간 뒤 담당이 적는다.
   *
   * 전환율은 숫자로만 보인다. 몇 퍼센트인지는 알겠는데 왜 그런지는 아무 데도 안 남아,
   * 다음 달에 같은 이유로 또 놓친다. 사유 한 칸과 적은 말 한 줄이면 달마다 견줄 수 있다.
   *
   * 적은 사람과 적은 때를 같이 남긴다 — 나중에 "이거 누가 본 건데" 가 꼭 나온다.
   */
  missReason   String    @default("") @db.VarChar(20)
  missReview   String    @default("") @db.Text
  missReviewBy String    @default("") @db.VarChar(30)
  missReviewAt DateTime?

  /**
   * 리콜 — 안 된 건에 다른 사람이 다시 전화를 걸어 보는 것.
   *
   * 담당자가 적는 리뷰와는 다른 일이다. 리뷰는 "왜 안 됐나"를 담당자가 적는 것이고,
   * 리콜은 팀장(지금은 대표)이 손님에게 직접 걸어 "문제가 있었나, 우리 직원이 실수한
   * 게 있나, 다른 차를 보겠나"를 묻는 것이다. 같은 칸에 섞으면 누가 한 말인지 모른다.
   *
   * 결과는 몇 가지로 끊어 둔다 — 사람마다 다르게 적으면 달마다 견줄 수가 없다.
   */
  recallAt     DateTime?
  recallBy     String    @default("") @db.VarChar(30)
  recallResult String    @default("") @db.VarChar(20)
  recallNote   String    @default("") @db.Text

  // 출고할 때 카톡방에 "12가3456 입금1000만원 동주 출고완료"처럼 올린다.
  // 그 입금액을 여기 남겨두면 정산으로 넘길 때 다시 묻지 않아도 된다(만원).
  depositAmount Int @default(0)

  /**
   * 차가 얼마에 팔렸나 — 원 단위.
   *
   * 남의 딜러가 우리 상사 차를 팔아 주는 일이 있다. 그 건은 우리 딜러가 정산을 받지
   * 않아서, 얼마에 팔렸는지를 전화를 받은 TM 말고는 아무도 모른다. 적어 둘 칸이
   * 없으니 그 사람 머리에만 남았다.
   *
   * 입금액(depositAmount)과는 다른 값이다. 그건 출고할 때 들어온 돈이고 만원 단위다.
   */
  salePrice Int @default(0)

  nextContactDate DateTime? @db.Date

  /**
   * 현금인가 할부인가.
   * 할부면 어느 캐피탈로 얼마를 깔았는지 같이 적는다 — 재고금융을 쓴 캐피탈에
   * 약정만큼 채웠는지 세는 값이다. 지난 상담은 안 적혀 있어서 UNKNOWN 으로 둔다.
   */
  payMethod          PayMethod @default(UNKNOWN)
  installmentCapital String    @default("") @db.VarChar(20)
  installmentAmount  Int       @default(0) // 할부 실행액(원)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee           @relation(fields: [employeeId], references: [id])
  files    ConsultationFile[]

  @@index([kind, date])
  @@index([sourceId])
  @@index([employeeId])
  @@index([vehicleNumber])
  @@index([customerPhone])
  @@index([date])
  @@index([visitDate])
}

model ConsultationFile {
  id             String   @id @default(cuid())
  consultationId String
  fileName       String
  url            String
  createdAt      DateTime @default(now())

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId])
}

// ─────────────────────────────────────────────
// ③ 정산 — 간편 / 알선 / 매입
// ─────────────────────────────────────────────

enum SettlementStatus {
  IN_PROGRESS
  COMPLETED
}

// 간편 정산(기존 양식)
model Settlement {
  id           String           @id @default(cuid())
  employeeId   String
  vehicleInfo  String
  purchaseCost Int              @default(0)
  prepCost     Int              @default(0)
  saleAmount   Int              @default(0)
  feeAmount    Int              @default(0)
  status       SettlementStatus @default(IN_PROGRESS)
  date         DateTime         @db.Date
  memo         String           @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([date])
}

// 알선 정산 — 시트지 컬럼 그대로.
// 수익금 / 판매 수익은 저장하지 않고 조회 시 계산한다(계산식이 바뀌어도 과거 데이터가 안 꼬이게).
/**
 * 알선 정산.
 * 금액은 '원' 단위다 — 다른 정산과 달리 만원이 아니다.
 * 할부 피처럼 12,345원으로 떨어지는 값이 있어 만원으로는 담기지 않는다.
 */
model BrokerageSettlement {
  id   String   @id @default(cuid())
  date DateTime @db.Date

  /**
   * 알선인가 수출인가.
   * 적는 칸도 계산도 같아서 표를 나누지 않고 한 칸으로 가른다. 상담에서 넘어올 때
   * 그쪽 종류를 그대로 물려받는다 — 상담 종류를 쓰는 것은 같은 구분이기 때문이다.
   */
  kind ConsultationKind @default(BROKERAGE)

  vehicleNumber      String
  vehicleName        String

  /**
   * 어디서 들어온 건인가 — 엔카 · 차차차 · 자사몰 · 지인소개 …
   *
   * 상담에도 같은 칸이 있지만 상담 없이 정산만 올라오는 건이 많다. 그러면 '어느 길로
   * 들어온 돈인지'가 통째로 빈다 — 광고비를 어디에 쓸지 가리는 값이라 그게 비면
   * 지난 달에 무엇이 벌어다 줬는지 아무도 못 센다.
   *
   * 글자로 담는다. 고르는 목록은 있지만 새 플랫폼이 생길 때마다 칸을 고치게 하면
   * 적는 사람이 '기타'로 넘긴다.
   */
  platform String @default("") @db.VarChar(40)

  totalSaleAmount    Int    @default(0) // 총 진행 판매금액
  ownerDeposit       Int    @default(0) // 실차주입금
  transferFee        Int    @default(0) // 이전비
  transferFeeBalance Int    @default(0) // 이전비 잔액
  cashCommission     Int    @default(0) // 현금 수수료

  /**
   * 현금 수수료를 대표가 실제로 받았는지.
   * 적어둔 금액과 손에 들어온 돈이 다를 수 있어 대표가 한 건씩 확인한다.
   * 언제 확인했는지를 같이 남긴다 — 확인만 남기면 나중에 언제 받은 건지 알 수가 없다.
   * 확인한 사람은 대표 한 명이라 따로 두지 않는다.
   */
  cashConfirmedAt DateTime?

  /**
   * 결재 — 매입 정산과 같은 흐름이다.
   * 계약서 사진을 붙여 올리면 본부장이 보고, 대표가 마지막에 찍는다.
   * 담당자에 따라 본부장을 건너뛰는 건이 있어 단계는 찍힌 날짜로 낸다.
   */
  contractPhotos   String           @default("") @db.Text
  submittedAt      DateTime?
  chiefApprovedAt  DateTime?
  chiefApprover    String           @default("") @db.VarChar(30)
  ceoApprovedAt    DateTime?
  ceoApprover      String           @default("") @db.VarChar(30)
  installmentFee   Int              @default(0) // 할부 피

  /**
   * 어느 캐피탈로 얼마를 깔았는가.
   *
   * 재고금융을 쓴 캐피탈에는 그 회사 할부를 얼마 이상 깔아 줘야 하는 약정이 있다.
   * 상담에도 같은 칸이 있지만 거기는 상담받을 때 적는 값이라 비어 있는 건이 많다 —
   * 정산은 돈이 오간 뒤에 적는 자리라 여기 적힌 값이 실제와 맞다.
   *
   * 할부 피는 우리가 받은 수수료고, 실행액은 손님이 깔아 준 원금이다. 약정은 원금으로 센다.
   */
  installmentCapital String @default("") @db.VarChar(20)
  installmentAmount  Int    @default(0) // 할부 실행액(원)
  insuranceFee     Int              @default(0) // 보험 피
  etcCost          Int              @default(0) // 기타비용
  // 실 차량판매가 — 차가 실제로 얼마에 나갔나. 실차주입금은 세금을 떼고 들어온 돈이라
  // 판매가가 아니다. 0은 '아직 안 적음'이고, 그때는 실차주입금 + 차대금업으로 대신 본다.
  realSalePrice    Int              @default(0)
  settlementAmount Int              @default(0) // 정산받을금액
  employeeId       String
  status           SettlementStatus @default(IN_PROGRESS)
  memo             String           @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([date])
  @@index([vehicleNumber])
}

/**
 * 구전을 어떻게 줬는가.
 * 현금으로 준 것만 판매수익에서 뺀다 — 3.3%·13.3%는 세금계산 쪽에서 따로 처리하고
 * 여기서는 안 센다.
 */
enum BrokerFeePayout {
  CASH // 현금
  TAX_3_3 // 3.3%
  TAX_13_3 // 13.3%
}

// 매입 정산 — 시트지 컬럼 그대로.
// 상품화총비용 / 매입+상품화총비용도 저장하지 않고 조회 시 계산한다.
//
// ⚠️ 금액 단위가 다른 정산과 다르다. 여기만 '원'이다.
//    광택 35,000원처럼 만원으로 안 떨어지는 비용이 흔한데 만원 정수로는 3.5를 못 담는다.
//    소수로 저장하면 더할 때 오차가 생기므로 원 단위 정수로 두고 화면에서 만원으로 환산한다.
//    덤으로 차량비용(원)과 단위가 같아져서 최종 합계를 낼 때 환산이 필요 없다.
model PurchaseSettlement {
  id            String   @id @default(cuid())
  date          DateTime @db.Date
  vehicleName   String
  vehicleNumber String
  transferFee   Int      @default(0) // 이전비 + 추가이전비
  purchasePrice Int      @default(0) // 매입가
  brokerFee     Int      @default(0) // 구전 — 상품화가 아니라 별도 항목이다

  /**
   * 플랫폼 수수료(원).
   *
   * 헤이딜러·엔카 경매장에서 사오면 그쪽에 수수료를 낸다. 차를 사오는 데 든 돈이라
   * 상품화가 아니라 매입 쪽에 붙는다 — 이전비·구전과 같은 자리다.
   *
   * 직접 사온 차는 0이다.
   */
  platformFee   Int      @default(0)

  // 구전 지급방식. 금액은 방식에 맞춰 brokerFee 에 적는다.
  brokerFeePayout BrokerFeePayout @default(CASH)

  /**
   * 상사 정산서 맨 아래 '실제지급액' — 통장에 실제로 들어온 돈.
   *
   * 상사는 판매가에서 매입가와 재고금융을 빼고 부가세·원천세까지 뗀 뒤에 넣어 준다.
   * 그 숫자를 적어 두면 판매수익을 그걸로 낸다 — 재고금융 이자도 세금도 이미 빠진
   * 금액이라 우리가 따로 적을 필요가 없다.
   *
   * 0이면 안 적은 것이다. 그때는 예전처럼 차량판매가에서 비용을 빼서 낸다.
   */
  payoutAmount Int @default(0)

  /**
   * 매도정산 — 이 차 판매수익을 몇 대 몇으로 나누는가.
   *
   * 차장·본부장이 매도 쪽을 맡은 건은 판매수익의 일부를 가져간다. 신차에서 넘어온 차와
   * 개인에게서 사온 차가 비율이 다르다.
   *
   *   NEW    신차 — 30%
   *   PERSON 개인 — 50%
   *
   * 비어 있으면 아직 안 정한 것이다(0원). 비율은 화면·서버 한 곳(settlement.calc.ts)에만
   * 적어 둔다 — 바뀌는 값이라 두 곳에 두면 한쪽만 고친다.
   */
  profitShare String @default("") @db.VarChar(10)

  /**
   * 매도정산을 이미 받았는가.
   *
   * 받은 건은 이번 달 받을 돈에서 빠져야 한다. 줄을 지우면 그 차가 얼마였는지가 같이
   * 사라지므로 지우지 않고 표시만 남긴다 — 표에서는 연한 빨강으로 줄이 그어진다.
   */
  profitSharePaid Boolean @default(false)

  // ── 판매 쪽 ──
  // 상담이 판매완료로 끝나면 여기까지 채운다. 산 값(위)과 판 값(아래)이 한 줄에 있어야
  // 그 차 한 대에서 얼마가 남았는지가 보인다.
  salePrice      Int @default(0) // 차량판매가(원)
  cashCommission Int @default(0) // 현금 수수료(원)
  installmentFee Int @default(0) // 할부 피(원)
  insuranceFee   Int @default(0) // 보험 피(원)
  dealerLoanFee  Int @default(0) // 차대금업(원)

  // ⚠️ 아래 6개는 PurchasePrepCost 명세로 옮겼다. 값을 옮겨둔 뒤 읽지도 쓰지도 않는다.
  //    옮긴 숫자가 맞는지 운영에서 확인한 다음 컬럼을 지운다(그때까지는 되돌릴 수 있게 남겨둔다).
  polishWashCost   Int @default(0)
  dentCost         Int @default(0)
  performanceCost  Int @default(0)
  deliveryCost     Int @default(0)
  repairCost       Int @default(0)
  diagnosisCost    Int @default(0)
  settlementAmount Int @default(0) // 정산금액(원)

  // ── 결재 ──
  // 계약팀이 빈칸을 채워 올리면 본부장이 보고, 대표가 마지막에 찍는다.
  // 단계는 저장하지 않고 찍힌 날짜로 낸다 — 단계와 날짜를 둘 다 두면 어긋난다.
  // 승인한 사람은 그때의 이름을 박아 남긴다. 나중에 사람이 바뀌어도 누가 찍었는지는 그대로다.
  /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /*
   * 계약서 사진.
   * 지금은 실물 계약서를 들고 본부장·대표에게 가서 결재를 받는다. 올릴 때 사진을 같이
   * 붙이면 결재하는 쪽에서 화면으로 보고 찍을 수 있다 — 종이를 들고 다닐 일이 없다.
   * 여러 장이 될 수 있어(앞장·뒷장·특약) 경로를 줄바꿈으로 이어 담는다.
   * 표를 따로 파지 않는 이유는 사진에 딸린 정보가 없기 때문이다 — 순서와 경로가 전부다.
   */
  contractPhotos String @default("") @db.Text

  submittedAt     DateTime?
  chiefApprovedAt DateTime?
  chiefApprover   String           @default("") @db.VarChar(30)
  ceoApprovedAt   DateTime?
  ceoApprover     String           @default("") @db.VarChar(30)
  // 신차이름 — 화면에서 뺐다. 지난 기록이 있어 칸은 남겨둔다.
  newCarName      String           @default("")
  employeeId      String
  status          SettlementStatus @default(IN_PROGRESS)
  memo            String           @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee  Employee           @relation(fields: [employeeId], references: [id])
  prepCosts PurchasePrepCost[]

  @@index([employeeId])
  @@index([date])
  @@index([vehicleNumber])
}

// ─────────────────────────────────────────────
// ④ 주차장
// ─────────────────────────────────────────────

enum ParkingStatus {
  DISPLAY // 전시중
  SOLD // 판매완료
  RESERVED // 예약중
  MOVING // 이동중
  REPAIR // 카모두수정 — 수정 들어간 차. 손대면 안 된다
}

model ParkingVehicle {
  id            String        @id @default(cuid())
  lot           String // 주차장 (예: B4F-B05)
  zone          String // 구역 (예: 9구역)
  slot          String // 위치 (앞/뒤)
  vehicleNumber String
  vehicleModel  String
  status        ParkingStatus @default(DISPLAY)
  employeeId    String
  memo          String        @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  // 한 칸에 차 한 대 — 중복 등록 방지
  @@unique([lot, zone, slot])
  @@index([employeeId])
  @@index([vehicleNumber])
}

/**
 * 부동산 — 사무실·주차장·창고로 쓰는 자리.
 * 대표만 본다. 보증금·월세·계약 기한이 들어 있어 전 직원이 볼 값이 아니다.
 * 월세 내는 날과 계약 끝나는 날을 같이 둔다 — 둘 다 놓치면 돈이 드는 일이라
 * 한 화면에서 보여야 한다.
 */
model Property {
  id   String @id @default(cuid())
  name String @db.VarChar(60) // 이름 — "배양동 창고", "본관 사무실"

  /**
   * 우리가 어느 쪽인가.
   * 임차 — 우리가 빌려 쓰는 자리. 보증금·월세가 나간다
   * 임대 — 우리가 빌려준 자리. 보증금·월세가 들어온다
   * 한 표에 섞여 있으면 월세 합계가 '나가는 돈'인지 '들어오는 돈'인지 알 수 없다.
   * 상대방 칸(ownerName/ownerPhone)도 이 값에 따라 임대인이 되기도 임차인이 되기도 한다.
   */
  side    String @default("임차") @db.VarChar(10)
  usage   String @default("") @db.VarChar(20) // 용도 — 사무실 / 주차장 / 창고 / 기타
  address String @default("") @db.VarChar(191)

  ownerName  String @default("") @db.VarChar(30) // 임대인
  ownerPhone String @default("") @db.VarChar(30)

  deposit     Int @default(0) // 보증금(원)
  monthlyRent Int @default(0) // 월세(원)
  payDay      Int @default(0) // 월세 내는 날(1~31). 0이면 정해진 날이 없다

  startOn DateTime? @db.Date // 계약 시작
  endOn   DateTime? @db.Date // 계약 만료

  memo   String  @db.Text
  active Boolean @default(true) // 계약이 끝났으면 내린다(지우지 않는다 — 지난 계약도 기록이다)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

/**
 * 부동산 임대차·전대차 계약서.
 * 한 자리에 여러 장이 붙는다 — 갱신할 때마다 새로 쓴다.
 * 금액은 원, 면적·지목처럼 등기부에서 옮겨 적는 값은 적힌 그대로 글자로 둔다
 * ("132.23", "3층 중 일부"처럼 숫자로만 안 떨어진다).
 * 주민등록번호·법인등록번호는 일부러 안 담는다. 인쇄물에 손으로 적으면 되는 값이라
 * 전산에 쌓아둘 이유가 없다 — 담는 순간 지켜야 할 것이 늘어난다.
 */
/**
 * 자리마다 달마다 나가는 돈 — 월세 · 관리비 · 주차 임대료 같은 것.
 * 고지서가 여러 장으로 흩어져 있어(임대료 한 장, 관리비 호실마다 한 장) '한 달에 얼마가
 * 고정으로 나가는지'를 셀 수가 없었다. 자리 밑에 달아 두고 합계를 낸다.
 * 금액은 부가세까지 더한 '실제로 빠져나가는 돈'으로 적는다 — 공급가액으로 적으면
 * 통장에서 나간 돈과 안 맞아 매달 다시 계산하게 된다.
 * 달마다 조금씩 오르내리는 건(전기·수도) 대표값 하나만 적어 둔다. 러프하게 보는 자리다.
 */
model PropertyCost {
  id String @id @default(cuid())

  /**
   * 어느 자리에서 나가는 돈인가. 비어 있으면 '사무실 부대비용'이다.
   *
   * 인터넷·정수기·복합기처럼 자리에 매이지 않고 매달 자동이체로 빠져나가는 것들이 있다.
   * 그걸 아무 건물 밑에 넣어두면 그 자리 고정비가 부풀어 자리끼리 비교가 안 된다.
   */
  propertyId String?
  kind       String @default("관리비") @db.VarChar(20) // 월세 / 관리비 / 주차 임대료 / 전기·수도 / 기타
  amount     Int    @default(0) // 한 달에 나가는 돈(원, 부가세 포함)

  /**
   * 대당 단가와 대수 — 주차 임대료처럼 대수가 오르내리는 것.
   * 50대가 들어올 수도 100대가 들어올 수도 있어서 금액만 적어두면 매달 다시 센다.
   * 둘 다 적으면 금액(amount)은 단가 × 대수로 서버가 낸다. 안 적으면 금액을 그냥 쓴다.
   */
  unitPrice Int     @default(0)
  units     Int     @default(0)
  payDay    Int     @default(0) // 내는 날(1~31). 0이면 정해진 날이 없다
  method    String  @default("직접이체") @db.VarChar(10) // 자동이체 / 직접이체
  payee     String  @default("") @db.VarChar(60) // 받는 곳 — 예금주·관리단
  account   String  @default("") @db.VarChar(60) // 은행·계좌
  memo      String  @default("") @db.VarChar(255)
  active    Boolean @default(true) // 끊기면 내린다(지우지 않는다 — 지난 달 비용이다)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
}

model LeaseContract {
  id         String @id @default(cuid())
  propertyId String
  kind       String @default("전대차") @db.VarChar(10) // 임대차 / 전대차
  rentType   String @default("월세") @db.VarChar(10) // 전세 / 월세

  // ── 부동산의 표시 ── 등기부에서 옮겨 적는다
  address           String @default("") @db.VarChar(191)
  landCategory      String @default("") @db.VarChar(30) // 지목
  landArea          String @default("") @db.VarChar(30)
  buildingStructure String @default("") @db.VarChar(60) // 구조·용도
  buildingArea      String @default("") @db.VarChar(30)
  leasedPart        String @default("") @db.VarChar(60) // 임대할 부분
  leasedArea        String @default("") @db.VarChar(30)

  // ── 제1조 보증금 및 지급시기 ──
  deposit        Int       @default(0)
  downPayment    Int       @default(0) // 계약금
  interimPayment Int       @default(0) // 중도금
  interimOn      DateTime? @db.Date
  balance        Int       @default(0) // 잔금
  balanceOn      DateTime? @db.Date
  monthlyRent    Int       @default(0) // 차임(월세)
  payDay         Int       @default(0) // 매월 며칠

  // ── 제2조 존속기간 ──
  handoverOn DateTime? @db.Date // 인도일
  startOn    DateTime? @db.Date
  endOn      DateTime? @db.Date

  brokerageRate String    @default("") @db.VarChar(10) // 중개보수 %
  special       String    @db.Text // 특약사항
  writtenOn     DateTime? @db.Date // 작성일

  lessorName       String @default("") @db.VarChar(30)
  lessorAddress    String @default("") @db.VarChar(191)
  lessorPhone      String @default("") @db.VarChar(30)
  lessorAgent      String @default("") @db.VarChar(30)
  lessorAgentPhone String @default("") @db.VarChar(30)

  lesseeName       String @default("") @db.VarChar(30)
  lesseeAddress    String @default("") @db.VarChar(191)
  lesseePhone      String @default("") @db.VarChar(30)
  lesseeAgent      String @default("") @db.VarChar(30)
  lesseeAgentPhone String @default("") @db.VarChar(30)

  brokerOffice  String @default("") @db.VarChar(60)
  brokerAddress String @default("") @db.VarChar(191)
  brokerName    String @default("") @db.VarChar(30)
  brokerRegNo   String @default("") @db.VarChar(30)
  brokerPhone   String @default("") @db.VarChar(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
}

/**
 * 거래처 대장.
 * 광택집·판금집·공업사·배터리·할부사처럼 전화할 일이 있는 곳을 한곳에 모은다.
 * 지금까지는 번호가 카톡 어딘가에만 있어서 필요할 때마다 올려 찾았다.
 * 분류는 글자로 둔다. '배터리', '공업사'처럼 쓰다 보면 늘어나는데, enum 으로 박으면
 * 한 종류 늘릴 때마다 표를 고쳐야 한다.
 */
/**
 * 인건비 — 누가 얼마를 받고, 공제를 누가 부담하고, 실제로 얼마가 나가는가.
 *
 * 실 이체액은 저장하지 않는다. 급여에서 공제를 빼고 식대를 더한 값이라 언제든 다시
 * 낼 수 있고, 저장해 두면 금액을 고쳤을 때 둘이 어긋난다.
 */
model PayrollEntry {
  id       String @id @default(cuid())
  name     String @db.VarChar(30) // 안원용 / 이태희 …
  position String @default("") @db.VarChar(20)

  monthlyPay       Int @default(0) // 급여(원)

  /**
   * 인센티브(원) — 달마다 얹히는 돈.
   *
   * 급여에 섞어 적으면 그 사람 기본급이 얼마인지 알 수 없게 된다. 급여는 정해진 값이고
   * 인센티브는 달마다 바뀌는 값이라, 섞어 두면 다음 달에 어디까지가 기본급이었는지
   * 되짚을 수가 없다.
   */
  incentive        Int @default(0)
  companyDeduction Int @default(0) // 회사공제(원)
  selfDeduction    Int @default(0) // 본인공제(원)
  mealAllowance    Int @default(0) // 식대(원)

  /** 공제를 누가 지는가 — '본인all' / '세금 all 회사부담' / '공제없음' 처럼 적어둔 말 그대로 */
  burden String  @default("") @db.VarChar(30)
  memo   String  @default("") @db.VarChar(255)
  active Boolean @default(true) // 그만두면 내린다(지우지 않는다 — 지난 달 인건비다)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vendor {
  id       String  @id @default(cuid())
  category String  @db.VarChar(20) // 광택·세차 / 판금·덴트 / 성능 / 탁송 / 공업사 / 배터리 / 할부사 …
  name     String  @db.VarChar(60)
  phone    String  @default("") @db.VarChar(30)
  phone2   String  @default("") @db.VarChar(30) // 번호가 둘인 곳
  manager  String  @default("") @db.VarChar(30) // 담당자 — 대표로 연락하는 사람
  address  String  @default("") @db.VarChar(255) // 어디로 가면 되는지
  memo     String  @default("") @db.VarChar(255) // 영업시간처럼 알아둘 것
  active   Boolean @default(true) // 거래 끊으면 내린다(지우지 않는다 — 지난 비용이 이 이름을 가리킨다)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts VendorContact[]

  @@index([category])
  @@index([name])
}

/**
 * 거래처 담당자 한 사람.
 *
 * 한 곳에 사람이 여럿이다 — 네바퀴 성능장만 해도 메인팀장·하부세척·픽업 담당이 따로다.
 * 업체 줄에 번호 칸을 늘리는 대신 사람을 붙인다. 누구에게 무슨 일로 거는지가 이름에 적힌다.
 */
model VendorContact {
  id       String @id @default(cuid())
  vendorId String
  name     String @default("") @db.VarChar(40) // 김재근 부장(메인팀장)
  phone    String @default("") @db.VarChar(30)
  sort     Int    @default(0) // 시트에 적힌 순서 그대로

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

// ─────────────────────────────────────────────
// ⑤ 매물 사진 게시판
// ─────────────────────────────────────────────

model VehiclePost {
  id            String @id @default(cuid())
  site          String // 엔카 / KB차차차 / 보배드림 ...
  vehicleNumber String
  vehicleModel  String // 차명
  customerPhone String // 손님번호
  content       String @db.Text
  employeeId    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee           @relation(fields: [employeeId], references: [id])
  photos   VehiclePostPhoto[]

  @@index([employeeId])
  @@index([vehicleNumber])
  @@index([createdAt])
}

// 사진은 base64로 DB에 넣지 않고 파일로 저장한 뒤 경로만 들고 있는다.
model VehiclePostPhoto {
  id        String @id @default(cuid())
  postId    String
  url       String // /uploads/vehicle-posts/xxxx.jpg
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())

  post VehiclePost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, sortOrder])
}

// ─────────────────────────────────────────────
// ⑥ 작업일지 — 날짜별 할 일 체크리스트(주간 플래너)
// ─────────────────────────────────────────────

// 한 줄이 곧 할 일 하나다. 날짜 단위로 여러 줄이 붙고, 화면에서는 요일별 칸에 모아 보여준다.
model WorkLog {
  id         String   @id @default(cuid())
  employeeId String
  date       DateTime @db.Date
  content    String   @db.Text
  done       Boolean  @default(false)
  sortOrder  Int      @default(0) // 같은 날 안에서의 순서

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, date])
  @@index([date])
}

// ─────────────────────────────────────────────
// ⑨ 웹 푸시 구독
// ─────────────────────────────────────────────

// 브라우저를 닫아둔 사람에게도 알림을 보내기 위한 구독 정보.
//
// 한 사람이 여러 기기(사무실 PC, 휴대폰)를 쓰므로 직원당 여러 건이 쌓인다.
// endpoint가 곧 기기 식별자다 — 브라우저가 발급하고 같은 기기에서는 같은 값이 온다.
// 브라우저에서 알림을 끄거나 앱을 지우면 endpoint가 죽는데(410/404), 그때는 발송하다가 지운다.
model PushSubscription {
  id         String  @id @default(cuid())
  employeeId String
  endpoint   String  @unique @db.VarChar(500) // 길어서 191자 기본값으로는 모자란다
  p256dh     String // 브라우저 공개키
  auth       String // 인증 시크릿
  userAgent  String? // 어느 기기인지 알아보기 위한 참고용

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

// ─────────────────────────────────────────────
// ⑧ 관리자 ↔ 직원 메시지
// ─────────────────────────────────────────────

// 두 사람 사이의 1:1 대화.
//
// 처음에는 직원당 하나로 두고 관리자 전원이 같은 방에 들어와 답했다. 그런데 직원이
// "안원용 본부장님께만" 보내고 싶어도 방법이 없었다. 그래서 상대를 지정할 수 있게
// (직원, 관리자) 쌍마다 방을 따로 둔다.
//
// employeeId/adminId라는 이름은 남겨두되, 조회는 "내가 어느 쪽이든" 걸리게 한다
// (관리자끼리 주고받으면 한쪽이 employeeId 자리에 들어간다).
model Conversation {
  id            String    @id @default(cuid())
  employeeId    String
  adminId       String
  lastMessageAt DateTime? // 목록 정렬용 — 매번 메시지를 세지 않게 캐시한다

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee      @relation("ConversationEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  admin    Employee      @relation("ConversationAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@unique([employeeId, adminId])
  @@index([adminId])
  @@index([lastMessageAt])
}

model ChatMessage {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String    @db.Text
  readAt         DateTime? // 상대가 읽은 시각 — 1:1이라 메시지마다 한 번만 찍힌다

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Employee     @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([senderId])
}

// ─────────────────────────────────────────────
// ⑦ 차량 관리 — 외부 이동 리스트 / 주유·배터리 비용
// ─────────────────────────────────────────────

// 매입되어 단지로 들어온 차량.
// 체크박스 세 개의 조합만으로 어느 리스트에 뜰지가 정해지므로 분류값은 따로 저장하지 않는다
// (규칙이 바뀌어도 과거 데이터가 안 꼬이게 — 정산 파생값과 같은 방침).
/**
 * 차종. 주차장 배치 기준이 차종부터 시작해서(SUV·화물은 평동, 소형차는 팬슬)
 * 차명 문자열만으로는 매번 다시 판단해야 해 따로 둔다.
 */
enum VehicleBodyType {
  COMPACT // 소형차
  SEDAN // 세단
  SUV
  TRUCK // 화물
  VAN // 승합
  OTHER
}

/**
 * 판매 유형 — 수출은 고색동 A·B, 일반광고는 고색동 C로 나뉜다.
 */
enum VehicleSaleType {
  GENERAL // 일반광고
  EXPORT // 수출
}

model ManagedVehicle {
  /**
   * 알선차 — 우리가 사온 차가 아니다.
   *
   * 남의 상사 차를 알선으로 팔면 매도는 매도인데 우리가 판 대수에 섞이면 안 된다.
   * 사무장이 오늘 매도 대수를 보는데 알선 건이 끼어 있으면 나중에 맞춰볼 수가 없다.
   *
   * 차량 관리에 없어도 되는 차지만, 언제 무엇을 넘겼는지는 남아야 해서 줄은 만든다 —
   * 대신 이 표를 달고 집계에서 뺀다.
   */
  brokered Boolean @default(false)

  id            String  @id @default(cuid())
  vehicleNumber String  @unique // "12가3456" 또는 "123가4567"
  plateTail     String // 뒤 4자리 — 주유·배터리 등록에서 이걸로 찾는다
  vehicleModel  String
  prepared      Boolean @default(false) // 상품화
  advertised    Boolean @default(false) // 광고 완료 — 상품화 없이는 켤 수 없다
  moveBlocked   Boolean @default(false) // 외부 이동 금지 — 켜지면 무조건 이동금지 리스트

  // ── 주차 배치 기준 ──
  // 어디에 세울지는 값·차종·연료·판매유형으로 갈린다. 매입 관리에서 들어온 값으로
  // 채워두고(가격·연료), 차명으로 알 수 있는 건 추론해 넣는다. 틀리면 손으로 고친다.
  priceManwon Int             @default(0) // 시세 또는 매입가(만원)
  fuel        String          @default("") @db.VarChar(20)
  bodyType    VehicleBodyType @default(OTHER)
  saleType    VehicleSaleType @default(GENERAL)
  isTaxi      Boolean         @default(false) // 택시 — 배양동 외부로 간다

  // 제시 가능 여부를 가리는 값. 매입 관리에서 들어올 때 같이 채워진다.
  modelYear String @default("") @db.VarChar(10) // 연식 — "2016"
  mileage   Int    @default(0) // 주행거리(km)

  // ── 재고금융(제시) ──
  // 제시 가능 여부는 저장하지 않고 연식·주행거리로 그때그때 가린다 —
  // 기준(10년 이내·20만km 미만)이 바뀌어도 지난 기록이 안 꼬이게.
  // 등록증에 적힌 최초등록일. 연식만으로는 10년차 경계를 가릴 수 없어서 그때만 채운다 —
  // 2016년식이라도 1월 등록이면 이미 10년을 넘고 12월 등록이면 아직 9년이다.
  firstRegisteredOn DateTime? @db.Date

  // 재고금융이 안 되는 차. 현금으로 사는 차라 제시 대상에서 뺀다.
  cashVehicle Boolean @default(false)

  offerDate    DateTime? @db.Date // 제시일자 — 캐피탈에 제시한 날
  transferDate DateTime? @db.Date // 이전일자 — 명의 이전한 날

  // 재검(성능점검 다시 받은 날). 이전일자로부터 넉 달이 지나면 다시 받아야 하는데,
  // 받고 나면 그날부터 다시 넉 달을 센다. 안 적혀 있으면 이전일자로 센다.
  lastInspectedOn DateTime? @db.Date

  // 매도일자 — 손님에게 실제로 넘긴 날.
  // 상담이 판매완료로 찍히면 출고 예정이 되고, 넘기고 나서 이 날짜를 적으면 매도로 끝난다.
  // 판매완료와 매도를 나눈 이유: 계약이 끝난 것과 차가 실제로 나간 것이 며칠씩 벌어지는데,
  // 그 사이가 광고·주차·상품화가 준비해야 하는 구간이다.
  soldDate DateTime? @db.Date

  // 매도금액(원) — 차가 얼마에 나갔나.
  // 같은 값이 네 곳에 적힌다: 상담 등록 · 제시 금융(여기) · 알선 정산의 실 차량판매가 ·
  // 매입 정산의 차량판매가. 어디서 적든 나머지 셋에 같이 들어간다(sale-price 모듈).
  salePrice Int @default(0)

  stockCapital String @default("") @db.VarChar(20) // 할부사
  stockAmount  Int    @default(0) // 재고금액(원)

  // 이 차 한 대에 쓴 광고비(원). 광고 관리에서 제시함·재고 잡힌 차만 골라 적는다 —
  // 재고로 잡아 우리가 들고 있는 차라야 광고를 붙이기 때문이다.
  adCost    Int       @default(0)
  repayDate DateTime? @db.Date // 상환일자 — 월별로 모아 본다

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses VehicleExpenseLog[]

  @@index([plateTail])
  @@index([vehicleModel])
  @@index([offerDate])
  @@index([repayDate])
  @@index([soldDate])
}

enum VehicleExpenseKind {
  FUEL // 주유
  BATTERY // 배터리
  PARKING // 주차비
  REPAIR // 소모품·수리 — 사이드미러, 타이어, 와이퍼 같은 것
  // 외부 주차장에서 세차해 주시는 분께 드리는 돈. 상품화의 '광택·세차'와 다르다 —
  // 그쪽은 팔려고 한 번 제대로 내는 일이고, 이건 세워 둔 차를 계속 닦는 일이다.
  WASH
  ETC // 기타 — 위 어디에도 안 들어가는 지출
}

// 주유 비고 — 배터리에는 쓰지 않는다
enum VehicleUsageNote {
  IN_PREP // 상품중
  TEST_DRIVE // 시승중
  SOLD // 판매완료
}

// 주유·배터리 이력. 한 대에 계속 쌓이고, 등록 후 수정·삭제할 수 있다.
// 금액 단위는 정산(만원)과 달리 '원'이다 — 주유비는 만원 단위로 떨어지지 않는다.
model VehicleExpenseLog {
  id         String             @id @default(cuid())
  vehicleId  String
  kind       VehicleExpenseKind
  amount     Int                @default(0) // 원
  date       DateTime           @db.Date
  note       VehicleUsageNote? // 주유일 때만 채운다
  // 무엇에 쓴 돈인지 적는 자유 입력. 소모품·수리와 기타는 항목 이름만으로는 알 수가 없다
  // (같은 '수리비'라도 타이어인지 썬팅인지가 나중에 정산에서 갈린다).
  memo       String             @default("") @db.VarChar(191)
  employeeId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle  ManagedVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  employee Employee       @relation(fields: [employeeId], references: [id])

  @@index([vehicleId, date])
  @@index([kind, date])
  @@index([employeeId])
}

// ─────────────────────────────────────────────
// ⑩ 매입리스트 — 재고금융(캐피탈 대출) 관리
// ─────────────────────────────────────────────

// ⚠️ 화면과 API를 걷어냈다. 재고금융은 차량 관리(ManagedVehicle)에서 보게 됐고,
//    이 장부는 쓰지 않는다. 표만 남겨둔 이유는 옮겨 적어둔 기록을 버리지 않기 위해서다 —
//    나중에 꺼내 볼 일이 없다고 확인되면 그때 지운다.
//
// 매입한 차를 캐피탈 재고금융으로 돌린 내역. 엑셀 '매입리스트' 시트를 대체했었다.
// 금액 단위는 정산(만원)과 달리 전부 '원'이다.
model PurchaseListItem {
  id            String    @id @default(cuid())
  seq           Int // 순번 — 엑셀에서 쓰던 번호를 그대로 들고 온다
  date          DateTime? @db.Date // 매입 날짜
  vehicleNumber String    @db.VarChar(30)
  vehicleName   String    @db.VarChar(60)
  managerName   String    @db.VarChar(30) // 담당자 — 직원 계정이 없는 사람도 적혀서 이름 문자열로 둔다
  askingPrice   Int       @default(0) // 제시가(원)
  modelYear     String    @db.VarChar(10) // 년식 — "2016"
  mileage       Int       @default(0) // 주행거리(km)

  // 재고 — 실제로 어느 캐피탈에서 얼마를 받았나
  stockCapital String? @db.VarChar(20) // 캐피탈사 이름. 'x'처럼 안 되는 경우도 그대로 적는다
  stockAmount  Int     @default(0) // 금액(원)

  // 재고가능금액 — 캐피탈사별로 얼마까지 가능한지 따로 적는다(원)
  limitBmw     Int @default(0)
  limitWoori   Int @default(0)
  limitKb      Int @default(0)
  limitMeritz  Int @default(0)
  limitHana    Int @default(0)
  limitHyundai Int @default(0)

  note String @default("") @db.VarChar(255) // 비고 — 특이사항("10년경과" 등)

  loanDate        DateTime? @db.Date // 대출일자
  interestRate    Float? // 이율(%)
  repayDate       DateTime? @db.Date // 상환일자 — 월별 현황은 이 날짜로 모은다
  loanStatus      String    @default("") @db.VarChar(30) // 대출상황("입금완료" 등)
  repaidDate      DateTime? @db.Date // 상환날짜 — 실제로 갚은 날
  repaymentAmount Int       @default(0) // 상환금액(원) — 월별 현황의 합계 대상

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([repayDate])
  @@index([vehicleNumber])
  @@index([seq])
}

// ─────────────────────────────────────────────
// ⑪ 매입 관리 — 차를 사올 때 받아 적는 인수 내역
// ─────────────────────────────────────────────

// 매입 담당이 카톡으로 주고받던 인수 내역을 그대로 옮긴 것.
// 고객·실차확인·차량스펙·매입금액이 한 건에 다 들어간다.
//
// 매입리스트(PurchaseListItem)와는 다른 단계다 — 여기는 '사올 때 확인한 것',
// 저기는 '사온 뒤 어느 캐피탈에 재고로 잡았나'다.
//
// 등록하면 같은 차량번호로 ManagedVehicle을 만들어 차량관리 탭에 바로 뜨게 한다.
// 연결은 정산과 같은 방식으로 차량번호 문자열로 잡는다(FK를 걸면 차량을 지울 때
// 매입 기록까지 묶여서, 서로 수명이 다른 두 장부가 엮인다).
model PurchaseIntake {
  id   String   @id @default(cuid())
  date DateTime @db.Date // 매입일

  customerPhone String @db.VarChar(20) // 고객번호
  customerName  String @db.VarChar(30) // 고객이름
  source        String @default("") @db.VarChar(120) // 매입처 — "아우디 평촌 류호성상조회장"
  inspector     String @default("") @db.VarChar(60) // 실차 확인자 — "검차업체(예나)"

  vehicleName       String    @db.VarChar(150) // 차명 — 수입차는 트림까지 붙어 길다
  // 세부모델(등급) — "2.4 GDI 프레스티지". 카비어에서 받아온 계약에는 등급이 없어서
  // 비워둔 채로 들어오고, 시세를 조회하면서 채운다.
  detailModel       String    @default("") @db.VarChar(120)
  vehicleNumber     String    @db.VarChar(30)
  modelYear         String    @default("") @db.VarChar(10) // 연식
  // 등록증에 적힌 최초등록일. 연식만으로는 재고금융 10년차 경계를 가릴 수 없어서
  // 등록증이 손에 있는 매입 때 같이 받아 적는다.
  firstRegisteredOn DateTime? @db.Date
  fuel              String    @default("") @db.VarChar(20) // 연료
  keyCount          Int       @default(0) // 차키갯수
  mileage           Int       @default(0) // 주행거리(km) — 매입할 때 받아 적은 값

  // 실차 확인자가 차를 직접 보고 다시 적는 주행거리. 처음 적은 것과 많이 벌어지면
  // 관리자에게 알린다(적어 온 값과 실제가 다르면 매입가를 다시 봐야 한다).
  // 0은 '아직 확인 안 함'이다 — 0km 인 차는 없다.
  /**
   * 실차 검차 — 차를 보러 가서 확인한 것들.
   *
   * 확인한 항목은 키를 쉼표로 이어 한 칸에 담는다. 항목이 늘 때마다 칸을 늘리면
   * 마이그레이션이 계속 붙는다 — 확인했다/안 했다 두 값뿐이라 이걸로 충분하다.
   */
  checkedItems String @default("") @db.VarChar(255)

  /** 센 개수 — 판금·덴트는 여기서 센 대로 상품화 비용이 잡힌다 */
  panelCount     Int     @default(0) // 판 몇 곳
  dentCount      Int     @default(0) // 덴트 몇 곳
  dentLargeCount Int     @default(0) // 그중 큰 덴트
  wheelCount     Int     @default(0) // 휠 복원 몇 짝
  prepVendor     String  @default("") @db.VarChar(10) // 판금 업체 — 대산 / KS
  imported       Boolean @default(false) // 수입차인가 — 판 단가가 갈린다

  /** 기름이 얼마나 있는가 — 많음 / 적정 / 없음. 넣고 가야 하는지를 가른다 */
  fuelLevel String @default("") @db.VarChar(10)

  /**
   * 검차 리포트 주소 — 카비어가 계약에 달아 주는 성능점검 결과다.
   *
   * 우리가 만드는 게 아니라 받아 적는 값이라 주소만 들고 있는다. 다시 받아올 때
   * 덮어쓰는데, 저쪽이 안 주면 지우지 않는다 — 있던 링크가 사라지면 못 본다.
   */
  reportUrl String @default("") @db.VarChar(500)

  checkedMileage Int    @default(0)
  note           String @default("") @db.VarChar(255) // 특이사항

  // 금액 단위는 매입리스트와 같은 '원'이다. 총액은 저장하지 않고 더해서 쓴다
  // (계산식이 바뀌어도 과거 데이터가 안 꼬이게 — 정산 파생값과 같은 방침).
  purchaseAmount Int           @default(0) // 실매입금액
  brokerFee      Int           @default(0) // 구전
  brokerFeeType  BrokerFeeType @default(CASH) // 구전 지급 방식 — 세금 처리가 다르다

  employeeId String // 등록자

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([date])
  @@index([vehicleNumber])
  @@index([customerName])
  @@index([employeeId])
}

// ─────────────────────────────────────────────
// ⑫ 매입 정산 — 상품화 비용 명세
// ─────────────────────────────────────────────

// 상품화 비용을 항목 6종으로 나누고, 항목 안에서 다시 업체·카테고리별로 적는다.
// 광택은 A광택집·B광택집으로 갈리고, 진단비는 플랫폼마다 광고 형태와 비용이 다르다.
//
// 예전에는 매입 정산에 항목별 금액 컬럼 하나씩만 있어서 "광택 얼마"까지만 남았다.
// 이제 이 명세가 원본이고, 항목별 합계와 상품화총비용은 조회할 때 더해서 낸다
// (저장하면 계산식이 바뀔 때 과거 데이터가 꼬인다 — 이 저장소의 다른 파생값과 같은 방침).
enum PrepCostKind {
  POLISH_WASH // 광택·세차
  DENT // 판금·덴트
  PERFORMANCE // 성능비
  DELIVERY // 탁송비
  REPAIR // 수리비
  DIAGNOSIS // 진단비 — 플랫폼 수수료
}

model PurchasePrepCost {
  id           String       @id @default(cuid())
  settlementId String
  kind         PrepCostKind
  vendor       String       @default("") @db.VarChar(60) // 업체·카테고리 — "A광택집", "엔카 프리미엄"
  amount       Int          @default(0) // 원 — 매입 정산과 같은 단위(화면에서는 만원으로 보여준다)
  memo         String       @default("") @db.VarChar(191)
  sortOrder    Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settlement PurchaseSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([settlementId])
  // 자동완성이 "지금까지 쓴 업체 이름"을 이 인덱스로 훑는다.
  @@index([kind, vendor])
}

// ─────────────────────────────────────────────
// ⑬ 청소 관리 대장
// ─────────────────────────────────────────────

// 벽에 붙여두고 손으로 체크하던 대장을 그대로 옮긴 것.
// 날짜·담당자·시간을 적고 항목마다 체크한다.
model CleaningLog {
  id         String   @id @default(cuid())
  floor      String   @default("5F") @db.VarChar(10) // 층 — 층마다 체크 항목이 다르다
  date       DateTime @db.Date
  employeeId String
  time       String   @db.VarChar(5) // "HH:mm" — 청소한 시각

  // 대장의 체크 칸. 어느 층에서 어떤 이름으로 쓰는지는 프론트 CLEANING_FLOORS 가 정한다 —
  // 층마다 항목이 다르지만 겹치는 것(쓸기·정수기·쓰레기·빗자루)은 같은 칸을 쓴다.
  // 칸이 늘거나 줄면 여기와 그 목록을 같이 고친다.
  sweep         Boolean @default(false) // 쓸기
  wipe          Boolean @default(false) // 닦기
  waterPurifier Boolean @default(false) // 정수기 / 정수기정리
  shredder      Boolean @default(false) // 파쇄기
  trashBin      Boolean @default(false) // 쓰레기통 / 쓰레기 비움
  paperCup      Boolean @default(false) // 종이컵
  broomClean    Boolean @default(false) // 빗자루닦기 / 빗자루 청소
  wetMop        Boolean @default(false) // 물걸레
  boxDisposal   Boolean @default(false) // 박스 버리기
  deskTidy      Boolean @default(false) // 책상 정리

  note String @default("") @db.VarChar(191) // 기타

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([floor, date])
  @@index([employeeId])
}

// ─────────────────────────────────────────────
// ⑭ 회원가입 신청
// ─────────────────────────────────────────────

enum SignupStatus {
  PENDING
  APPROVED
  REJECTED
}

// 직원이 직접 아이디를 만들고 관리자가 승인하면 계정이 생긴다.
//
// 신청은 Employee 가 아니라 여기 쌓인다 — 승인 전 신청까지 직원 명단에 섞이면
// 출퇴근·정산 화면 곳곳의 "직원 목록"이 오염된다. 승인될 때 Employee 를 만든다.
//
// 비밀번호는 신청 때 이미 해시해서 넣는다. 승인을 기다리는 동안에도 평문이 어디에도 남지 않게.
model SignupRequest {
  id           String @id @default(cuid())
  loginId      String @unique
  passwordHash String
  name         String @db.VarChar(30)
  position     String @default("") @db.VarChar(30)
  department   String @default("") @db.VarChar(30) // 소속 팀 — 작업일지를 팀끼리 나눠 본다
  phone        String @default("") @db.VarChar(20)

  // 신청한 브라우저의 지문. 승인할 때 "이 PC를 출근 단말로도 등록" 을 고르면 쓴다.
  // 자동으로 등록하지는 않는다 — 휴대폰으로 신청하면 휴대폰이 출근 단말이 되어버린다.
  fingerprint String? @db.VarChar(64)

  status     SignupStatus @default(PENDING)
  reviewedAt DateTime?
  reviewNote String?      @db.VarChar(191)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ─────────────────────────────────────────────
// ⑮ 치운 통화
// ─────────────────────────────────────────────

// 상담으로 옮겼거나 볼 일 없는 통화를 목록에서 치운다.
//
// 통화 자체는 채널톡 것이라 지울 수 없고, 지워서도 안 된다 — 녹취는 나중에 다툴 때
// 꺼내 보는 물건이다. 그래서 저쪽은 그대로 두고 우리 목록에서만 가린다.
//
// 브라우저에 두지 않고 여기 둔다. 한 사람이 처리한 전화가 옆자리 화면에는 그대로
// 남아 있으면 같은 손님에게 두 번 전화가 간다.
//
// 지운 사람과 시각을 남긴다. 휴지통에서 되돌릴 때 누가 치운 건지 보여야 한다.
model DismissedCall {
  id String @id @default(cuid())

  // 채널톡 대화 id — 통화 한 건을 가리킨다
  userChatId String @unique @db.VarChar(64)

  // 되돌릴 때 목록에 뭐가 들었는지 보여주려고 적어 둔다.
  // 채널톡에서 다시 받아오면 되지만, 휴지통을 열 때마다 저쪽을 훑을 일은 아니다.
  customerPhone String @default("") @db.VarChar(20)
  calledAt      String @default("") @db.VarChar(20)

  dismissedById String
  dismissedBy   Employee @relation(fields: [dismissedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─────────────────────────────────────────────
// ⑯ 외부주차장 세차
// ─────────────────────────────────────────────

// 세차하러 오신 날.
//
// 외부 주차장에 세워 둔 차를 한 대당 만 원에 닦아 주신다. 주 두 번 오시기로 했는데
// 실제로 몇 번 왔는지는 아무도 안 세고 있었다 — 달이 끝나고 청구서를 받으면 그게
// 맞는지 따질 근거가 없다.
//
// 대수는 그날 주차장에 있던 차를 세어 채워 두고, 다르면 손으로 고친다. 청구서와
// 우리 장부가 갈릴 때 어느 쪽이 맞는지는 사람이 봐야 안다.
model WashVisit {
  id   String   @id @default(cuid())
  date DateTime @db.Date

  // 어느 주차장에 왔는지. 외부 주차장이 일곱 군데라 한 덩어리로 묶으면 어디를 빠뜨렸는지 모른다
  lot String @db.VarChar(40)

  // 그날 닦은 대수 — 한 대당 만 원이 붙는 값이다
  carCount Int @default(0)

  memo String @default("") @db.VarChar(191)

  recordedById String?
  recordedBy   Employee? @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 같은 날 같은 주차장에 두 번 적히지 않게
  @@unique([date, lot])
  @@index([date])
}

// 달마다 치르는 값.
//
// 매달 30일에 한 번에 낸다. 얼마를 냈고 냈는지 안 냈는지만 남긴다 —
// 대수와 단가는 방문 기록에서 나오지만, 실제로 치른 값은 흥정이 붙어 다를 수 있다.
model WashSettlement {
  id    String @id @default(cuid())
  month String @unique @db.VarChar(7) // YYYY-MM

  // 청구 대수 — 비워 두면 그 달 방문 기록에서 센다
  carCount Int @default(0)
  // 한 대당 값. 바뀔 수 있어서 그 달에 적용한 값을 같이 남긴다
  unitPrice Int @default(1250)

  paid   Boolean   @default(false)
  paidOn DateTime? @db.Date
  memo   String    @default("") @db.VarChar(191)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// ⑰ 상품화 차량 사진
// ─────────────────────────────────────────────

// 여섯 방향 — 손님에게 보여줄 때도, 나중에 흠집을 두고 다툴 때도 이 여섯 장이 기준이다.
enum VehiclePhotoSlot {
  FRONT // 전면
  REAR // 후면
  LEFT // 좌측
  RIGHT // 우측
  DASH // 계기판 — 주행거리가 여기 찍힌다
  INTERIOR // 실내
}

// 한 차를 한 날 찍은 묶음.
//
// 상품화가 끝나면 찍어 둔다. 지금은 각자 휴대폰에 남아서, 손님이 사진을 달라고 하면
// 찍은 사람을 찾아 다녀야 하고 그 사람이 쉬는 날이면 못 준다.
//
// 차와 날로 하나만 둔다. 같은 날 두 번 찍으면 덮어쓴다 — 같은 날 두 묶음이 있으면
// 어느 게 최신인지 여는 사람이 알 수가 없다. 날이 다르면 따로 쌓인다(상품화 전후를
// 견주는 일이 있다).
model VehiclePhotoSet {
  id String @id @default(cuid())

  // 차량관리와 번호로 맞춘다. 차가 팔려 사라져도 사진은 남아야 해서 관계로 묶지 않는다
  vehicleNumber String @db.VarChar(30)
  vehicleName   String @default("") @db.VarChar(60)

  shotOn DateTime @db.Date
  memo   String   @default("") @db.VarChar(191)

  photos VehiclePhoto[]

  recordedById String?
  recordedBy   Employee? @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vehicleNumber, shotOn])
  @@index([shotOn])
}

model VehiclePhoto {
  id    String          @id @default(cuid())
  setId String
  set   VehiclePhotoSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  slot VehiclePhotoSlot
  url  String           @db.VarChar(255)

  createdAt DateTime @default(now())

  // 한 방향에 한 장. 다시 올리면 갈아끼운다
  @@unique([setId, slot])
}

// ─────────────────────────────────────────────
// ⑱ 경조사비
// ─────────────────────────────────────────────

enum CondolenceKind {
  FUNERAL // 장례 — 부의
  WEDDING // 결혼 — 축의
  HOLIDAY // 명절 세트 — 추석·설에 돌리는 것
  ETC // 돌잔치·개업 같은 나머지
}

// 경조사비 대장.
//
// 지금은 카톡으로 주고받고 만다. "김재웅 20만원 플러스 화환" 같은 말이 흩어져 있어서,
// 연말에 얼마를 썼는지도 모르고 다음에 같은 자리에서 얼마를 내야 하는지도 모른다.
// 받은 데 또 안 내는 일도, 두 번 내는 일도 여기서 생긴다.
//
// 화환은 금액과 따로 둔다. 대표님이 "전부 화환은 추가"라고 하셨듯 늘 얹는 것이라
// 한 칸에 합쳐 두면 축의금이 얼마였는지가 사라진다.
model Condolence {
  id   String         @id @default(cuid())
  kind CondolenceKind

  // 누구 일인가. 우리 직원일 수도, 거래처 대표일 수도 있다
  person String @db.VarChar(40)
  // 그 사람과 어떤 사이인지 — '거래처 대표', '직원', '타상사'
  relation String @default("") @db.VarChar(30)

  /**
   * 연락처.
   *
   * 경조사는 받은 쪽이 나중에 갚는다 — 우리 쪽 일이 있을 때 연락할 번호가 대장에 없으면
   * 그때 가서 또 수소문한다. 적어 둔 김에 남겨 둔다.
   *
   * 지금은 적어 두기만 한다. 한꺼번에 문자를 보내는 건 건당 돈이 드는 일이라 따로 정한다.
   */
  phone String @default("") @db.VarChar(20)
  // 당사자와의 관계 — '본인', '부친', '모친', '친누나'. 부고에 적힌 그대로 받는다
  subject String @default("") @db.VarChar(30)

  // 언제 있었던 일인가. 부고·청첩장에 적힌 날
  eventOn DateTime @db.Date

  // 낸 돈. 화환값은 여기 안 넣는다
  amount Int @default(0)
  // 화환을 보냈는지와 그 값 — 보통 45,000원이지만 다를 수 있다
  wreath      Boolean @default(false)
  wreathPrice Int     @default(0)

  place String @default("") @db.VarChar(80)
  memo  String @default("") @db.VarChar(191)

  recordedById String?
  recordedBy   Employee? @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventOn])
  @@index([kind])
}

/**
 * 판금집이 보낸 청구서 총액.
 *
 * 줄마다 붙인 금액을 다 더해도 청구서 총액과 안 맞는 달이 있다 — 판을 몇 개로 셌는지가
 * 현장과 판금집이 다르고, 청구서에는 있는데 우리 매입 정산에는 없는 차도 섞여 온다.
 * 어느 차가 틀렸는지 한 줄씩 따지는 건 사람이 할 일이 아니다.
 *
 * 그래서 차에 나눠 붙이지 않는다. 받은 총액을 그대로 적어 두고, 판금·덴트 합계는 이
 * 값으로 덮어쓴다. 차마다의 원가는 청구서에 적힌 금액 그대로 남는다 — 맞추자고 남의
 * 차 원가를 올리면 그 차 순이익이 틀어진 채로 결재까지 간다.
 *
 * 달과 업체로 한 줄이다. 대산과 KS를 따로 적으면 둘을 더한 값이 판금·덴트 총액이 된다.
 */
model PanelInvoiceTotal {
  id String @id @default(cuid())

  month  String @db.VarChar(7) // YYYY-MM
  vendor String @db.VarChar(20) // 대산 / KS / 광택집

  /**
   * 어느 항목의 청구서인가 — DENT(판금·덴트) / POLISH_WASH(광택·세차) / PERFORMANCE …
   *
   * 판금만 청구서로 오는 게 아니다. 광택은 사진으로 오고 아직 읽을 방법이 없어 총액만
   * 적는데, 그 금액이 판금 칸에 얹히면 안 된다.
   */
  kind String @default("DENT") @db.VarChar(20)
  amount Int    @default(0) // 청구서에 찍힌 총액(원)

  /**
   * 몇 건인가.
   *
   * 클리닉처럼 달마다 열몇 건씩 붙는 비용은 금액만 적어두면 다음 달에 늘었는지 줄었는지
   * 견줄 데가 없다. 건수를 같이 적어 두면 건당 얼마였는지가 남는다. 0이면 안 적은 것이다.
   */
  count Int @default(0)

  /** 적은 사람 — 이름 두 개로 못 박은 그 사람들이다. 나중에 누가 적었는지 묻는다 */
  writer String @default("") @db.VarChar(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /*
    달 · 업체 · 항목으로 한 줄이다.

    업체만으로 묶으면 같은 집에 판금과 광택을 같이 맡겼을 때 뒤에 적은 것이 앞의 것을
    갈아끼운다 — 한 줄을 적을 때마다 앞 줄이 하나씩 사라진다.
  */
  @@unique([month, vendor, kind])
  @@index([month])
}

/**
 * 판금집이 보낸 청구서 파일.
 *
 * 엑셀로 오는 달도 있고 카톡 사진으로 오는 달도 있다. 넣고 나면 파일은 각자 컴퓨터에만
 * 남아, 나중에 "그 달 청구서 원본 어디 있냐"는 말이 나오면 찾을 데가 없다.
 *
 * 올린 파일을 달·업체로 묶어 둔다. 금액이 왜 저렇게 적혔는지 물어볼 때 볼 것은 원본이다.
 */
/**
 * 매입 정산에 붙는 식대 — 달마다 한 사람에 한 줄.
 *
 * 이우주 차장과 안원용 본부장 두 사람은 정산금액에 식대가 같이 붙는다. 차 한 대에
 * 붙는 값이 아니라 달마다 한 번 적는 값이라 정산 줄에 넣지 않고 따로 둔다 — 줄에
 * 넣으면 어느 차에 붙일지부터 정해야 하고, 그건 아무 뜻이 없는 질문이다.
 *
 * 금액만 담는다. 합계는 볼 때마다 더한다.
 */
/**
 * 장기 재고 경고 — 들어온 지 오래된 차를 단계마다 한 번씩 알린다.
 *
 * 차는 오래 들고 있을수록 손해다. 자리값이 들고, 시세는 떨어지고, 재고금융 이자가 붙는다.
 * 그런데 매일 보는 목록에서는 오래된 차가 새 차 사이에 섞여 있어 눈에 안 띈다.
 *
 * 서른 날·마흔닷새·예순 날을 넘길 때 한 번씩 알린다. 넘길 때마다 할 일이 다르다 —
 * 서른 날은 값을 다시 보고, 마흔닷새는 내리고, 예순 날은 도매로 넘길지 정한다.
 *
 * 보낸 기록을 남기는 이유는 두 가지다. 같은 차를 매일 다시 알리지 않으려는 것이 하나고,
 * 알린 뒤에 무엇을 했는지(값을 내렸는지, 도매로 넘겼는지) 적어 두려는 것이 둘이다.
 *
 * 되사온 차는 입고일이 다르므로 같은 차량번호라도 다시 센다.
 */
/**
 * 상품화 일정 — 차가 들어와서 광고에 올라가기까지.
 *
 * 들어온 차를 나흘 안에 광고까지 올리는 것이 목표다. 하루 늦으면 그만큼 재고일수가
 * 늘고, 늘어난 날수는 그대로 이자와 시세 하락이 된다.
 *
 * 단계가 넷이다.
 *   ① 검차·성능점검      들어온 날
 *   ② 판금·광택 외주 잡기  이튿날~사흘째
 *   ③ 사진 촬영          나흘째
 *   ④ 매물 등록(광고)     나흘째
 *
 * 날짜를 적는 이유는 '며칠 걸렸나'를 세기 위해서다. 체크만 해 두면 끝났다는 것만 알고
 * 어디서 늦어졌는지는 모른다 — 늦는 자리는 늘 같은 자리다.
 *
 * 사진은 상품화 사진 묶음이 생기면 저절로 채워진다. 같은 일을 두 번 적게 하지 않는다.
 */
model PrepSchedule {
  id String @id @default(cuid())

  vehicleNumber String   @unique @db.VarChar(30)
  vehicleName   String   @default("") @db.VarChar(120)
  /** 들어온 날 — 여기서부터 센다(매입 관리의 매입일) */
  intakeDate    DateTime @db.Date

  inspectedOn    DateTime? @db.Date // ① 검차·성능점검
  outsourcedOn   DateTime? @db.Date // ② 판금·광택 외주 잡음
  photographedOn DateTime? @db.Date // ③ 사진 촬영
  listedOn       DateTime? @db.Date // ④ 매물 등록(광고 게시) — 여기까지가 끝이다

  memo String @default("") @db.VarChar(255)

  /** 늦었다고 알린 적이 있는가 — 같은 차를 매일 다시 알리지 않으려고 둔다 */
  lateNotifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([intakeDate])
}

model StockAgeAlert {
  id String @id @default(cuid())

  vehicleNumber String   @db.VarChar(30)
  vehicleName   String   @default("") @db.VarChar(120)
  /** 그때의 입고일 — 되사온 차를 가르는 값이다 */
  intakeDate    DateTime @db.Date
  /** 넘긴 단계 — 30 · 45 · 60 */
  stage         Int

  /** 알릴 때의 재고일수 — 나중에 '며칠 만에 알렸나'를 본다 */
  days       Int      @default(0)
  notifiedAt DateTime @default(now())

  /** 무엇을 했는가 — 가격인하 · 도매전환 · 보류. 빈 글자면 아직 안 했다 */
  action     String    @default("") @db.VarChar(20)
  actionNote String    @default("") @db.VarChar(255)
  actionBy   String    @default("") @db.VarChar(30)
  actionAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 같은 차 같은 입고일에 같은 단계는 한 번뿐이다
  @@unique([vehicleNumber, intakeDate, stage])
  @@index([vehicleNumber])
}

model SettlementMeal {
  id String @id @default(cuid())

  month      String @db.VarChar(7) // YYYY-MM
  employeeId String
  amount     Int    @default(0) // 그 달 식대(원)

  /** 적은 사람 — 본인이거나 대표다. 나중에 누가 적었는지 묻는다 */
  writer String @default("") @db.VarChar(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 달 · 사람으로 한 줄
  @@unique([month, employeeId])
  @@index([month])
}

model PanelInvoiceFile {
  id String @id @default(cuid())

  month  String @db.VarChar(7) // YYYY-MM
  vendor String @db.VarChar(20) // 대산 / KS

  url  String @db.VarChar(255) // /uploads/panel-invoice/… — Apache가 그대로 내준다
  name String @default("") @db.VarChar(120) // 올릴 때 파일 이름. 화면에 보여줄 때만 쓴다
  mime String @default("") @db.VarChar(80)
  size Int    @default(0)

  /** 올린 사람 — 나중에 누가 올렸는지 묻는다 */
  writer String @default("") @db.VarChar(30)

  createdAt DateTime @default(now())

  @@index([month])
  @@index([month, vendor])
}

/**
 * 알선 딜러 인센티브 — 달마다 한 사람에 한 줄.
 *
 * 기본급을 깔고, 월 알선 총액이 기본급을 넘은 만큼에 구간 요율을 곱해 인센티브를 낸다.
 * 요율은 초과분이 아니라 '월 알선 총액'이 어느 구간인지로 고른다 — 800만을 한 사람과
 * 1,000만을 한 사람은 같은 초과분에도 다른 요율을 받는다.
 *
 * 계산에 쓰는 값만 저장한다. 인센티브·실수령액·회사 순수익은 저장하지 않는다 —
 * 저장해 두면 요율표를 고쳤을 때 지난 달 숫자와 어긋난다. 볼 때마다 다시 낸다.
 */
model DealerIncentive {
  id String @id @default(cuid())

  month      String @db.VarChar(7) // YYYY-MM
  employeeId String

  /**
   * 월 알선 총액(원).
   *
   * 그 달 그 사람 알선 정산의 '정산받을금액'을 더해 채워 두지만, 정산에 안 올라온 건이
   * 있어 손으로 고칠 수 있다. 0이면 아직 안 적은 것이라 집계값을 쓴다.
   */
  sales Int @default(0)

  /** 근속 연차 — 0~5년. 기본급이 여기서 나온다(0년 200만 … 5년 300만) */
  years Int @default(0)

  /** 기본급을 따로 정했으면 그 값(원). 0이면 근속표대로 */
  baseSalary Int @default(0)

  /** 팀장 오버라이딩을 5%로 줄 달인가 — 목표를 채웠으면 켠다 */
  targetAchieved Boolean @default(false)

  memo String @default("") @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([month, employeeId])
  @@index([month])
}

/**
 * 사내 게시판 — 전 직원이 보는 공지.
 *
 * 지금은 텔레그램 공지방으로만 돌린다. 방에 들어온 뒤의 글만 보이고, 지난 공지를 찾으려면
 * 올려 가며 뒤져야 한다. 들어오면 보이는 자리에 남겨 둔다.
 *
 * 금액은 여기에도 안 적는다 — 전 직원이 보는 자리라는 점은 공지방과 같다.
 */
/**
 * 그 달 계약 목표.
 *
 * 브라우저에만 담아 뒀었다 — 대표 혼자 보는 숫자라 서버에 둘 일이 아니라고 봤다.
 * 그런데 팀장이 같이 보게 되면서 각자 다른 숫자를 보게 됐다. 한 사람이 적은 목표를
 * 다른 사람이 못 보면 그건 목표가 아니다.
 *
 * 달마다 한 줄이다. 누가 마지막으로 고쳤는지만 남긴다 — 언제 몇으로 바꿨는지까지
 * 쌓을 값은 아니다.
 */
model ContractGoal {
  month     String   @id @db.VarChar(7) // YYYY-MM
  target    Int      @default(0)
  updatedBy String   @default("") @db.VarChar(30)
  updatedAt DateTime @updatedAt
}

/**
 * 주차장 구조 — 어떤 주차장에 어떤 구역이 몇 줄로 있는가.
 *
 * 코드에 박아 두었다. 줄 하나를 늘리거나 이름을 고치려면 개발자가 고쳐 올려야 했는데,
 * 실제로 줄을 긋고 차를 대는 건 차량관리팀이다 — 그 팀이 화면에서 고치게 한다.
 *
 * 번지(lot)는 저장된 값이다. 세워 둔 차와 세차 기록이 전부 이 값으로 묶여 있어서
 * 바꾸면 지난 기록이 엉뚱한 주차장을 가리킨다 — 부르는 이름(label)만 따로 둔다.
 *
 * 구역과 줄은 줄바꿈으로 이어 한 칸에 담는다. 칸을 따로 두면 표가 둘 늘어나는데,
 * 늘 통째로 읽고 통째로 쓰는 값이라 쪼갤 까닭이 없다.
 */
model ParkingLotLayout {
  lot       String  @id @db.VarChar(60) // 번지 — 저장된 값이라 안 바꾼다
  label     String  @default("") @db.VarChar(60) // 화면에 띄울 이름
  area      String  @default("외부") @db.VarChar(10) // 본관 / 외부
  bandColor String  @default("#e2e8f0") @db.VarChar(20)
  zones     String  @db.Text // 구역 이름 — 줄바꿈으로 이어 담는다
  slots     String  @default("") @db.Text // 줄 이름 — 비우면 본관 기본값(앞1·앞2·뒤1·뒤2)
  sortOrder Int     @default(0) // 늘어놓는 차례 — 차를 어디로 보낼지 정하는 순서다
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([area, sortOrder])
}

model Notice {
  id       String  @id @default(cuid())
  category String  @default("일반") @db.VarChar(10) // 공지 · 업무 · 일반
  title    String  @db.VarChar(120)
  body     String  @db.Text
  /// 위에 고정 — 늘 봐야 하는 글이 아래로 밀리면 아무도 안 본다
  pinned   Boolean @default(false)

  authorId String
  author   Employee @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([authorId])
}

/**
 * 텔레그램으로 내보낸 것.
 *
 * 지금은 보냈는지 안 보냈는지가 서버 로그에만 남는다. 로그는 PM2 안에 있어서 사람이
 * 못 보고, 며칠 지나면 밀려 사라진다 — "그 차 올라갔나?"를 방을 뒤져서 확인해야 했다.
 *
 * 보낸 글을 그대로 남긴다. 못 보낸 것도 남긴다 — 안 간 걸 모르는 게 제일 나쁘다.
 */
model TelegramLog {
  id   String       @id @default(cuid())
  room TelegramRoom

  /** 보낸 방 번호 — 방을 옮겼을 때 어느 방으로 갔는지가 남아야 한다 */
  chatId String @default("") @db.VarChar(40)

  /** 보낸 글 그대로 */
  text String @db.Text

  /** 갔는가. 못 갔으면 까닭을 적는다 */
  ok     Boolean @default(false)
  reason String  @default("") @db.VarChar(300)

  /** 어느 차 이야기인가 — 차량번호로 찾아보려고 따로 둔다 */
  vehicleNumber String @default("") @db.VarChar(30)

  /** 손으로 올린 쪽지는 누가 올렸는지가 남아야 한다 — 숫자를 물어볼 자리다 */
  sentBy String @default("") @db.VarChar(40)

  /**
   * 방에 뜬 쪽지 번호 — 지울 때 쓴다.
   *
   * 목록에서만 지우면 방에는 그 쪽지가 그대로 남는다. 잘못 올린 줄을 지우는 까닭이
   * 그 방을 보는 사람이 틀린 숫자로 입금을 넣지 않게 하려는 건데, 방에 남으면 아무
   * 소용이 없다.
   */
  messageId String @default("") @db.VarChar(30)

  createdAt DateTime @default(now())

  @@index([room, createdAt])
  @@index([vehicleNumber])
}

enum TelegramRoom {
  BROADCAST // 공지방 — 전 직원이 본다. 금액은 안 간다
  SALE // 입금확인방 — 차량판매가가 바뀌면
